# Hyphenated frontmatter keys (sub-category, use-case, date-revised) are accessed via
# bracket notation, e.g. note["sub-category"], since a bare hyphen parses as subtraction.
filters:
  and:
    - 'category == "review-and-verification"'
    - 'file.ext == "md"'

views:
  - type: table
    name: "review-and-verification prompts"
    order:
      - file.name
      - note["sub-category"]
      - topic
      - note["use-case"]
      - visibility
      - note["date-revised"]
