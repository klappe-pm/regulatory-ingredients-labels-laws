# Hyphenated keys (sub-category, use-case, date-created, date-revised) are read via bracket notation, e.g. note["sub-category"], because bare hyphens parse as subtraction.
filters:
  and:
    - 'category == "reflection"'
    - 'note["type"] == "prompt"'

views:
  - type: table
    name: "reflection prompts"
    order:
      - file.name
      - note["sub-category"]
      - topic
      - note["use-case"]
      - visibility
      - note["date-revised"]
    groupBy:
      property: note["sub-category"]
      direction: ASC
