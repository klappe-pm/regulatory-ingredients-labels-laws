filters:
  and:
    - file.ext == "md"
    - or:
        - note["types"].contains("prompt")
        - note["types"].contains("skill")
properties:
  file.name:
    displayName: Prompt
  category:
    displayName: Category
  note["sub-category"]:
    displayName: Sub-category
  note["use-case"]:
    displayName: Use case
  visibility:
    displayName: Visibility
  note["date-revised"]:
    displayName: Revised
views:
  - type: table
    name: All prompts
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - note["sub-category"]
      - note["use-case"]
      - visibility
      - note["date-revised"]
